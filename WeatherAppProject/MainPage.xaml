<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherAppProject.MainPage"
             Shell.NavBarIsVisible="False">
    
    <!-- Gradient background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#141E30" Offset="0.0" />
            <GradientStop Color="#243B55" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25">

            <!-- App heading -->
            <Label Text="Weather Forecast"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />

            <!-- County selection -->
            <VerticalStackLayout Spacing="10">

                <Label Text="Select your county"
                       FontSize="16"
                       TextColor="White" />

                <Picker Title="Select a county"
                        x:Name="CountyPicker"
                        SelectedIndex="0"
                        TextColor="White"
                        TitleColor="#AABBD0"
                        BackgroundColor="#334B68">

                    <Picker.Items>
                        <x:String>Antrim</x:String>
                        <x:String>Armagh</x:String>
                        <x:String>Carlow</x:String>
                        <x:String>Cavan</x:String>
                        <x:String>Clare</x:String>
                        <x:String>Cork</x:String>
                        <x:String>Derry</x:String>
                        <x:String>Donegal</x:String>
                        <x:String>Down</x:String>
                        <x:String>Dublin</x:String>
                        <x:String>Fermanagh</x:String>
                        <x:String>Galway</x:String>
                        <x:String>Kerry</x:String>
                        <x:String>Kildare</x:String>
                        <x:String>Kilkenny</x:String>
                        <x:String>Laois</x:String>
                        <x:String>Leitrim</x:String>
                        <x:String>Limerick</x:String>
                        <x:String>Longford</x:String>
                        <x:String>Louth</x:String>
                        <x:String>Mayo</x:String>
                        <x:String>Meath</x:String>
                        <x:String>Monaghan</x:String>
                        <x:String>Offaly</x:String>
                        <x:String>Roscommon</x:String>
                        <x:String>Sligo</x:String>
                        <x:String>Tipperary</x:String>
                        <x:String>Tyrone</x:String>
                        <x:String>Waterford</x:String>
                        <x:String>Westmeath</x:String>
                        <x:String>Wexford</x:String>
                        <x:String>Wicklow</x:String>
                    </Picker.Items>

                </Picker>

                <Button x:Name="CountyPickerBtn"
                        Text="Confirm County"
                        Clicked="CountyEnteredReceived"
                        BackgroundColor="#4A90E2"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50" />

            </VerticalStackLayout>

            <!-- Main temperature -->
            <VerticalStackLayout Spacing="5"
                                 HorizontalOptions="Center">

                <Label
                    x:Name="locationLbl"
                    Text="Galway"
                    FontSize="45"
                    FontAttributes="Bold"
                    TextColor="White" 
                    HorizontalOptions="Center" />

                <Label 
                    Text="14°C"
                    x:Name="temperatureLbl"
                    FontSize="60"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalOptions="Center" />

                <Label 
                    x:Name="weatherConditionLbl"
                    Text="Partly Cloudy"
                    FontSize="20"
                    TextColor="White"
                    HorizontalOptions="Center" />

            </VerticalStackLayout>

            <!-- Weather details -->



            <Border
    Padding="15"
    BackgroundColor="#40303B50"
    StrokeThickness="0"
    StrokeShape="RoundRectangle 20">

                <VerticalStackLayout Spacing="15">

                    <!-- Forecast heading -->
                    <Label
            Text="24-HOUR FORECAST"
            FontSize="14"
            FontAttributes="Bold"
            TextColor="White" />

                    <!-- Subtle divider -->
                    <BoxView
            HeightRequest="1"
            BackgroundColor="#60FFFFFF"
            HorizontalOptions="Fill" />

                    <!-- Scrollable hourly forecast -->
                    <CollectionView
            ItemsSource="{Binding HourlyForecast}"
            ItemsLayout="HorizontalList"
            HeightRequest="110"
            HorizontalScrollBarVisibility="Never"
            SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate>

                                <VerticalStackLayout
                        WidthRequest="65"
                        Spacing="10"
                        HorizontalOptions="Center">

                                    <Label
                            Text="{Binding Time}"
                            FontSize="12"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                                    <Label
                            Text="{Binding Icon}"
                            FontSize="25"
                            HorizontalTextAlignment="Center" />

                                    <Label
                            Text="{Binding Temperature}"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />

                                </VerticalStackLayout>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>

                    </CollectionView>

                </VerticalStackLayout>

            </Border>




        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>
